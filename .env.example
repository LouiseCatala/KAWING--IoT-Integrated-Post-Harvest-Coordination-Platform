DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kawing
DB_USER=kawing
DB_PASSWORD=kawing_local
IOT_API_KEY=change-this-before-production

# Optional integrations
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Gmail SMTP (server-side PHP only; use a Google App Password, never your Gmail password)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-kawing-account@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password
MAIL_FROM=your-kawing-account@gmail.com
MAIL_FROM_NAME=KAWING Notifications
MAIL_TEST_RECIPIENT=your-personal-email@example.com
